<!-- pages/calendar/calendar.wxml -->
<view class="topbar">
  <view>
    <view class="h1">21 天日历</view>
    <view class="sub">{{rangeText}}</view>
  </view>
</view>

<view class="page-wrap">
  <view class="card">
    <view class="cal-week">
      <text wx:for="{{weekdays}}" wx:key="index" class="w">{{item}}</text>
    </view>
    <view class="cal-grid">
      <block wx:for="{{cells}}" wx:key="key">
      <view wx:if="{{item.empty}}"></view>
      <view wx:else
        class="cal-cell {{item.cls}}"
        bindtap="onCellTap"
        data-date="{{item.date}}"
        data-day="{{item.dayNum}}">
        <view class="num">{{item.num}}</view>
        <view class="dot"></view>
      </view>
      </block>
    </view>
    <view class="cal-legend">
      <view class="lg"><view class="sw full"></view><text>全部完成</text></view>
      <view class="lg"><view class="sw partial"></view><text>部分完成</text></view>
      <view class="lg"><view class="sw none"></view><text>未开始</text></view>
      <view class="lg"><view class="sw today"></view><text>今天</text></view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">点击日期查看详情</view>
    <block wx:if="{{selected}}">
      <view class="dd-head">
        <view class="dd-day">第 {{selected.dayNum}} 天</view>
        <view class="dd-date">{{selected.dateText}}</view>
      </view>
      <view class="dd-list">
        <view wx:if="{{selected.tasks.length === 0}}" class="empty">当天没有目标日项目</view>
        <view
          wx:for="{{selected.tasks}}"
          wx:key="id"
          class="check-item {{item.done ? 'done' : ''}}">
          <view class="icon" style="background: {{item.colorBg}}; color: {{item.color}}">{{item.icon}}</view>
          <view class="name">
            <text>{{item.name}}</text>
            <text wx:if="{{item.btnMakeup}}" class="ck-makeup" bindtap="onMakeup" data-id="{{item.id}}" data-date="{{item.date}}"> 补打卡 (剩{{item.remain}})</text>
            <text wx:elif="{{item.sub}}" class="ck-sub {{item.met ? 'met' : ''}}"> {{item.sub}}</text>
          </view>
          <view class="check-box"></view>
        </view>
      </view>
      <block wx:if="{{selected.todos.length > 0}}">
        <view class="card-title" style="margin-top: 24rpx">当日完成的任务</view>
        <view wx:for="{{selected.todos}}" wx:key="id" class="check-item done">
          <view class="name">
            <view>{{item.title}}</view>
            <view wx:if="{{item.note}}" class="todo-note">{{item.note}}</view>
          </view>
          <view class="check-box"></view>
        </view>
      </block>
      <view class="card-title" style="margin-top: 24rpx">心得</view>
      <view wx:if="{{selected.mood}}" class="dd-mood">{{selected.mood}}</view>
      <view class="dd-note">{{selected.note}}</view>
    </block>
    <view wx:else class="empty">选择上方任意一天</view>
</view>
</view>
