/* pages/tasks/tasks.wxss */
.topbar { padding: 48rpx 32rpx 16rpx; }
.topbar .h1 { font-size: 44rpx; font-weight: 700; }
.topbar .sub { font-size: 26rpx; color: var(--text-2); margin-top: 8rpx; }

.task-row {
  display: flex; align-items: center;
  padding: 28rpx 24rpx; border-radius: 24rpx;
  background: var(--bg); margin-bottom: 20rpx;
}
.task-row .icon {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; margin-right: 24rpx;
}
.task-row .info { flex: 1; }
.task-row .name { font-size: 30rpx; font-weight: 500; }
.task-row .rate { font-size: 24rpx; color: var(--text-2); margin-top: 4rpx; }
.task-row .ops { display: flex; gap: 16rpx; }
.task-row .op {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  background: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}

.add-btn { margin-top: 28rpx; }

