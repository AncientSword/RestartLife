.guide { padding: 40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); max-width: 1000rpx; margin: 0 auto; }
.progress { font-size: 24rpx; color: var(--primary); margin-bottom: 20rpx; }
.title { font-size: 44rpx; font-weight: 700; margin-bottom: 24rpx; }
.description { font-size: 28rpx; color: var(--text-2); line-height: 1.8; margin-bottom: 28rpx; }
.date { font-size: 34rpx; padding: 16rpx 0; color: var(--primary); }
.option { display: flex; align-items: center; padding: 20rpx 0; font-size: 30rpx; }
.habit + .habit { border-top: 2rpx solid var(--line); }
.schedule { display: flex; flex-wrap: wrap; gap: 24rpx; padding: 0 0 20rpx 16rpx; font-size: 26rpx; }
.back { margin-top: 20rpx; }
.custom-days { padding-bottom: 24rpx; }
.custom-hint { font-size: 24rpx; color: var(--text-2); margin-bottom: 16rpx; }
.target-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8rpx; }
.target-weekdays { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8rpx; text-align: center; font-size: 22rpx; color: var(--text-2); margin-bottom: 12rpx; }
.target-day { display: flex; align-items: center; justify-content: center; min-height: 64rpx; border-radius: 12rpx; background: var(--bg); font-size: 22rpx; }
.target-day.selected { background: var(--primary); color: #fff; }
