/* pages/stats/stats.wxss */
.topbar { padding: 48rpx 32rpx 16rpx; }
.topbar .h1 { font-size: 44rpx; font-weight: 700; }
.topbar .sub { font-size: 26rpx; color: var(--text-2); margin-top: 8rpx; }

.stat-big { display: flex; justify-content: center; padding: 20rpx 0; }
.stat-big .ring { width: 240rpx; height: 240rpx; position: relative; }
.ring-bg { position: absolute; inset: 0; border-radius: 50%; transition: background 0.6s; }
.ring-inner {
  position: absolute; inset: 24rpx; border-radius: 50%; background: var(--card);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.pct { font-size: 52rpx; font-weight: 700; color: var(--primary); }
.pct-sub { font-size: 24rpx; color: var(--text-2); }

.stat-mini { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 32rpx; }
.stat-mini .cell { background: var(--bg); border-radius: 24rpx; padding: 28rpx; text-align: center; }
.stat-mini .n { font-size: 44rpx; font-weight: 700; }
.stat-mini .l { font-size: 24rpx; color: var(--text-2); margin-top: 4rpx; }

.bar-row { margin-bottom: 24rpx; }
.bar-row .top {
  display: flex; justify-content: space-between;
  font-size: 26rpx; margin-bottom: 12rpx;
}
.bar-row .track {
  height: 16rpx; background: var(--bg);
  border-radius: 999rpx; overflow: hidden;
}
.bar-row .fill {
  height: 100%; border-radius: 999rpx; transition: width 0.4s;
}

.heat {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 12rpx;
}
.heat .h { aspect-ratio: 1; border-radius: 12rpx; background: #ECECE6; }

.plan-info { font-size: 26rpx; color: var(--text-2); margin-bottom: 28rpx; }

.share-btn { margin-bottom: 20rpx; }
.import-box { margin-top: 24rpx; }
.import-input {
  width: 100%; min-height: 240rpx; padding: 24rpx;
  background: var(--bg); border-radius: 20rpx;
  font-size: 24rpx; line-height: 1.5; box-sizing: border-box;
  margin-bottom: 20rpx; font-family: monospace;
}

/* 任务进度卡 */
.todo-head {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 20rpx;
}
.big-num { font-size: 56rpx; font-weight: 700; color: var(--accent); }
.muted { font-size: 26rpx; color: var(--text-2); }
.track {
  height: 20rpx; background: var(--bg);
  border-radius: 999rpx; overflow: hidden;
}
.fill {
  height: 100%; border-radius: 999rpx; transition: width 0.4s;
}
.fill.accent { background: var(--accent); }
.stat-mini { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 24rpx; }
.stat-mini .cell { background: var(--bg); border-radius: 24rpx; padding: 28rpx; text-align: center; }
.stat-mini .n { font-size: 44rpx; font-weight: 700; }
.stat-mini .n.danger { color: var(--danger); }
.stat-mini .l { font-size: 24rpx; color: var(--text-2); margin-top: 4rpx; }